{
  "name": "@caseywebb/homebridge-free-sleep",
  "publishConfig": {
    "access": "public"
  },
  "displayName": "Free Sleep",
  "version": "0.2.0",
  "description": "Control an Eight Sleep Pod running free-sleep from Apple Home, locally and without the Eight Sleep cloud.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caseyWebb/homebridge-free-sleep.git"
  },
  "bugs": {
    "url": "https://github.com/caseyWebb/homebridge-free-sleep/issues"
  },
  "engines": {
    "node": "^22 || ^24 || ^26",
    "homebridge": "^2.0.0"
  },
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "eight-sleep",
    "free-sleep",
    "homekit",
    "thermostat",
    "local"
  ],
  "files": [
    "dist",
    "config.schema.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "watch": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "smoke": "node --experimental-strip-types scripts/smoke.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@homebridge/hap-nodejs": "2.2.2",
    "@types/node": "^22.10.0",
    "eslint": "^10.10.0",
    "homebridge": "^2.4.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.69.0",
    "vitest": "^3.2.0"
  }
}
